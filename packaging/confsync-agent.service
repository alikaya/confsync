[Unit]
Description=confsync agent — watches configuration for changes
Documentation=man:confsync-agent(1)
# The tray icon and notifications depend on a graphical session.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/confsync-agent
Restart=on-failure
RestartSec=10
# The tray host (status bar) may come up after the agent; if there is no
# StatusNotifierWatcher on the first try the process fails and is retried.
StartLimitBurst=5
StartLimitIntervalSec=120
Environment=RUST_LOG=info,zbus=warn,tracing=warn

[Install]
WantedBy=graphical-session.target
